# Ignore everything by default
/*

# Except these core directories and files
!/client/
!/server/
!/common/
!/README.md
!/.gitignore
!/go.work
!/go.work.sum
!/build_clients.sh
!/Makefile
!/core/
!/bridge/
!/apps/
!/design/
!/docs/
!/deploy/

# General exclusions
*.key
gomesh-state/
*.log
*.exe
*.out
*.app

# Compiled binaries
client/client
server/server
client_bin
server_bin
client/Clients
server/Servers
bin/
dist/

# OS generated files and project metadata
.DS_Store
*.code-workspace
/client/downloads/
/client/data_received/
/data/

# Apple app build output (regenerated by make)
*.xcframework
*.xcodeproj/
xcuserdata/
DerivedData/
.build/
# Each developer's own signing team and server address.
/apps/apple/Config/Local.xcconfig

# A client data directory (the terminal client's is client/): the vault holds
# the account key and session token in plain files, so none of it may be staged.
vault/
state/
media/
servers.json
session.json
downloads/
# Git on macOS ignores case, so vault/ above also matches the app's Vault/
# source folder; that one is code, and goes in.
!/apps/apple/GoMesh/Vault/

# Dev TLS material and server database
*.pem
*.db
*.db-wal
*.db-shm

# Go workspaces and caches
.gocache/
.gomodcache/
.gotmp/
.cache/
local_cache/
local_tmp/
tmp/