# /etc/gomesh/gomesh.env: the server's settings. It holds the Supabase service
# key, so keep it readable by root and the gomesh user only:
#
#   sudo install -m 0640 -o root -g gomesh gomesh.env.example /etc/gomesh/gomesh.env

# Where the server listens. Open this port, and only this one, in the
# instance's security group.
LISTEN_ADDR=:8080

# The database. /var/lib/gomesh is the service's own folder, on the instance's
# EBS volume.
DB_PATH=/var/lib/gomesh/gomesh.db

# The TLS certificate. Clients pin its fingerprint the first time they connect,
# so keep these files: a new certificate means every device has to trust the
# server again.
TLS_CERT=/etc/gomesh/tls/cert.pem
TLS_KEY=/etc/gomesh/tls/key.pem

# Files and photos go to a private Supabase Storage bucket, uploaded and
# downloaded by the apps through short-lived signed URLs. Leave these empty to
# turn sending files off.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=gomesh-media
